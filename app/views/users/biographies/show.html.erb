<div class="mx-auto max-w-2xl w-full px-4 py-16">
  <div class="rounded-2xl border border-line bg-surface p-8 shadow-sm">
    <h1 class="font-serif font-medium text-3xl tracking-tight text-ink">About you</h1>
    <p class="mt-3 text-ink-soft">
      Let's start with the basics. This builds an inventory of the important people, events and
      details of your life for your family and your advisors. Every question is optional, so only
      answer the ones you'd like to. There's no word limit — write as much or as little as you'd like.
    </p>

    <%= form_with model: @biography, url: users_biography_path, method: :patch, class: "contents",
          data: { controller: "debounced-form", action: "input->debounced-form#submit" } do |form| %>
      <% if @biography.errors.any? %>
        <div class="mt-5 py-2 px-3 bg-danger-tint text-danger font-medium rounded-lg" id="error_explanation">
          <ul class="list-disc list-inside">
            <% @biography.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <section class="mt-10">
        <h2 class="font-serif font-medium text-2xl tracking-tight text-ink">Basics</h2>

        <div class="my-5 grid grid-cols-1 gap-5 sm:grid-cols-2">
          <div>
            <%= form.label :birth_date, t("user_biographies.prompts.birth_date"), class: "block text-sm font-medium text-ink" %>
            <%= form.date_field :birth_date, class: "block shadow-sm rounded-md border border-line bg-surface px-3 py-2 mt-2 w-full focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/10" %>
          </div>
          <div>
            <%= form.label :birthplace, t("user_biographies.prompts.birthplace"), class: "block text-sm font-medium text-ink" %>
            <%= form.text_field :birthplace, class: "block shadow-sm rounded-md border border-line bg-surface px-3 py-2 mt-2 w-full focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/10" %>
          </div>
        </div>
      </section>

      <%= render "section", form: form, heading: "Roots", fields: UserBiography::ROOTS %>
      <%= render "section", form: form, heading: "Education & career", fields: UserBiography::EDUCATION_AND_CAREER %>
      <%= render "section", form: form, heading: "Community & interests", fields: UserBiography::COMMUNITY_AND_INTERESTS %>
      <%= render "section", form: form, heading: "Family", fields: UserBiography::FAMILY %>
      <%= render "section", form: form, heading: "Reflections", fields: UserBiography::REFLECTIONS %>

      <p class="mt-6 text-sm text-ink-faint">Your answers save automatically as you type.</p>
    <% end %>
  </div>
</div>
