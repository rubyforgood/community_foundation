<% input_classes = "block shadow-sm rounded-md border border-line bg-surface px-3 py-2 mt-2 w-full focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/10" %>
<% label_classes = "text-sm font-medium text-ink" %>
<% sections = [
  [ "Roots", [
    [ :what_brought_you_here, "If not a native, what brought you to this area?", nil ],
    [ :other_places_lived, "Other places lived", nil ],
    [ :background, "Background", "Where you're from, your work, the path that brought you here." ]
  ] ],
  [ "Education & career", [
    [ :education, "Education", "Including any honors and degrees earned." ],
    [ :military_service, "Military service", "Including rank, years of service, deployments and where stationed." ],
    [ :professional_licenses, "Professional licenses held", nil ],
    [ :employment_history, "Employment history", nil ]
  ] ],
  [ "Community & interests", [
    [ :civic_organizations, "Civic, political and fraternal organizations and clubs", "Including offices held." ],
    [ :religious_affiliations, "Church / religious affiliations", nil ],
    [ :hobbies, "Hobbies and other activities", nil ]
  ] ],
  [ "Family", [
    [ :marriages, "Marriage(s)", nil ],
    [ :parents, "Parents' names and occupations", "Including mother's maiden name." ],
    [ :family_members, "Family members", "Names of parents, siblings, children, grandchildren, or anyone else important in your life. Note relationship." ]
  ] ],
  [ "Reflections", [
    [ :formative_experiences, "Experiences that shaped you", "Moments, people, or turning points that shaped your values." ],
    [ :other, "Anything else you'd like to share?", nil ]
  ] ]
] %>

<div class="mx-auto max-w-2xl w-full px-4 py-16">
  <div class="rounded-2xl border border-line bg-surface p-8 shadow-sm">
    <h1 class="font-serif font-medium text-3xl tracking-tight text-ink">About you</h1>
    <p class="mt-3 text-ink-soft">
      Let's start with the basics. This builds an inventory of the important people, events and
      details of your life for your family and your advisors. Every question is optional, so only
      answer the ones you'd like to. There's no word limit — write as much or as little as you'd like.
    </p>

    <%= form_with model: @biography, url: users_biography_path, method: :patch, class: "contents",
          data: { controller: "debounced-form", action: "input->debounced-form#submit" } do |form| %>
      <% if @biography.errors.any? %>
        <div class="mt-5 py-2 px-3 bg-danger-tint text-danger font-medium rounded-lg" id="error_explanation">
          <ul class="list-disc list-inside">
            <% @biography.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <h2 class="mt-8 font-serif font-medium text-xl text-ink">Basics</h2>

      <div class="my-5 grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div>
          <%= form.label :birth_date, "Birth date", class: label_classes %>
          <%= form.date_field :birth_date, class: input_classes %>
        </div>
        <div>
          <%= form.label :birthplace, "Birthplace", class: label_classes %>
          <%= form.text_field :birthplace, placeholder: "City, state or country", class: input_classes %>
        </div>
      </div>

      <% sections.each do |heading, fields| %>
        <h2 class="mt-8 font-serif font-medium text-xl text-ink"><%= heading %></h2>

        <% fields.each do |field, label, placeholder| %>
          <div class="my-5">
            <%= form.label field, label, class: label_classes %>
            <%= form.text_area field, rows: 5, placeholder: placeholder, class: input_classes %>
          </div>
        <% end %>
      <% end %>

      <p class="mt-6 text-sm text-ink-faint">Your answers save automatically as you type.</p>
    <% end %>
  </div>
</div>
